{
  "name": "@rezamonangg/pi-code-preview",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "keywords": ["pi-package", "pi", "markdown", "preview", "syntax-highlighting", "tmux"],
  "description": "Markdown + code preview for pi TUI using native theme-aware syntax highlighting.",
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
